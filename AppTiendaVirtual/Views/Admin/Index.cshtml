@model List<AppTiendaVirtual.Models.Producto>
@{
    ViewData["Title"] = "Panel de Administración";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-0" style="color:#1a1a1a;">
                <i class="bi bi-gear" style="color:#C9A84C"></i> Panel de Administración
            </h2>
            <p style="color:#888;font-size:0.85rem;margin:4px 0 0;">
                Gestiona tu catálogo de productos
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="/admin/crear" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Nuevo Producto
            </a>
            <a href="/admin/promociones" class="btn btn-outline-warning">
                <i class="bi bi-tags me-1"></i> Promociones
            </a>
            <a href="/admin/reportes" class="btn btn-outline-info">
                <i class="bi bi-bar-chart me-1"></i> Reportes
            </a>
        </div>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle me-2"></i>@TempData["Exito"]
        </div>
    }

    <!-- Resumen rápido -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card text-center p-3">
                <div style="font-size:1.8rem;color:#C9A84C;font-weight:900;">
                    @Model.Count
                </div>
                <div style="font-size:0.8rem;color:#888;font-weight:600;">Total productos</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center p-3">
                <div style="font-size:1.8rem;color:#166534;font-weight:900;">
                    @Model.Count(p => p.Activo)
                </div>
                <div style="font-size:0.8rem;color:#888;font-weight:600;">Activos</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center p-3">
                <div style="font-size:1.8rem;color:#dc2626;font-weight:900;">
                    @Model.Count(p => p.Inventarios.Sum(i => i.Stock) == 0)
                </div>
                <div style="font-size:0.8rem;color:#888;font-weight:600;">Agotados</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center p-3">
                <div style="font-size:1.8rem;color:#0891b2;font-weight:900;">
                    @Model.Sum(p => p.Inventarios.Sum(i => i.Stock))
                </div>
                <div style="font-size:0.8rem;color:#888;font-weight:600;">Unidades en stock</div>
            </div>
        </div>
    </div>

    <!-- Tabla -->
    <div class="card">
        <div class="card-header fw-bold">
            <i class="bi bi-table me-2"></i> Catálogo de productos
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">Imagen</th>
                        <th>Nombre</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        var stock = p.Inventarios.Sum(i => i.Stock);
                        var stockColor = stock == 0 ? "danger" : stock <= 5 ? "warning" : "success";
                        <tr>
                            <td class="ps-3">
                                <img src="@(p.Imagenes.FirstOrDefault()?.Url ?? "/images/no-image.png")"
                                     style="width:56px;height:56px;object-fit:cover;border-radius:10px;border:1px solid #e5e0d5" />
                            </td>
                            <td>
                                <span class="fw-bold" style="color:#1a1a1a;">@p.Nombre</span>
                            </td>
                            <td style="color:#888;">@p.Categoria?.Nombre</td>
                            <td>
                                <span class="fw-bold" style="color:#C9A84C;">
                                    $@p.Precio.ToString("N2")
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-@stockColor">@stock uds.</span>
                            </td>
                            <td>
                                <span class="badge bg-@(p.Activo ? "success" : "secondary")">
                                    @(p.Activo ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">
                                    <a href="/admin/editar/@p.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a href="/admin/inventario/@p.Id"
                                           class="btn btn-sm btn-outline-info"
                                           title="Inventario">
                                        <i class="bi bi-box-seam"></i>
                                    </a>
                                    <a href="/admin/toggle/@p.Id"
                                           class="btn btn-sm btn-outline-warning"
                                           title="@(p.Activo ? "Desactivar" : "Activar")">
                                        <i class="bi bi-toggle-@(p.Activo ? "on" : "off")"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>