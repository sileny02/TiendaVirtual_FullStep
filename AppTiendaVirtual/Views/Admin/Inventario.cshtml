@model AppTiendaVirtual.Models.Producto
@{
    ViewData["Title"] = "Gestionar Inventario";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Inventario — @Model.Nombre</h2>
        <a href="/admin" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <!-- Formulario agregar stock -->
    <div class="card mb-4">
        <div class="card-header fw-bold">Agregar combinación de Talla + Color + Stock</div>
        <div class="card-body">
            <form asp-controller="Admin" asp-action="AgregarInventario" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productoId" value="@Model.Id" />

                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Talla</label>
                        <select name="tallaId" class="form-select">
                            @foreach (var t in ViewBag.Tallas as IEnumerable<dynamic> ?? new List<dynamic>())
                            {
                                <option value="@t.Id">@t.Numero</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Color</label>
                        <select name="colorId" class="form-select">
                            @foreach (var c in ViewBag.Colores as IEnumerable<dynamic> ?? new List<dynamic>())
                            {
                                var colorSeleccionado = ViewBag.ColorSeleccionado == c.Id;
                                <option value="@c.Id" selected="@colorSeleccionado">@c.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Stock</label>
                        <input type="number" name="stock" class="form-control" min="0" value="0" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-plus-lg"></i> Agregar
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de inventario actual -->
    <div class="card">
        <div class="card-header fw-bold">Stock actual</div>
        <div class="card-body">
            @if (Model.Inventarios.Any())
            {
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Talla</th>
                            <th>Color</th>
                            <th>Stock</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in Model.Inventarios)
                        {
                            <tr>
                                <td>@inv.Talla?.Numero</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(inv.Color?.HexCodigo))
                                    {
                                        <span class="badge" style="background-color:@inv.Color.HexCodigo">
                                            &nbsp;&nbsp;&nbsp;
                                        </span>
                                    }
                                    @inv.Color?.Nombre
                                </td>
                                <td>@inv.Stock</td>
                                <td>
                                    <span class="badge bg-@(inv.Stock == 0 ? "danger" : inv.Stock <= 5 ? "warning" : "success")">
                                        @(inv.Stock == 0 ? "Agotado" : inv.Stock <= 5 ? "Bajo" : "Alto")
                                    </span>
                                </td>
                                <td>
                                    <form asp-controller="Admin" asp-action="EliminarInventario"
                                          method="post" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@inv.Id" />
                                        <input type="hidden" name="productoId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('¿Eliminar esta combinación?')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No hay inventario registrado para este producto.</p>
            }
        </div>
    </div>
</div>
