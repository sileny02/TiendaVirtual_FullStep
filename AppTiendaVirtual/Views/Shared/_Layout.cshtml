<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — FullStep</title>
    <link rel="icon" type="image/png" href="/images/MiTiendaVirtualLogo.png" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

<style>
    * { box-sizing: border-box; }

    body {
        background: #f5f0e8;
        color: #1a1a1a;
        font-family: 'Segoe UI', sans-serif;
        min-height: 100vh;
    }

    /* ── Navbar ── */
    .navbar-main {
        background: #fff;
        border-bottom: 2px solid rgba(201,168,76,0.4);
        padding: 0;
        box-shadow: 0 2px 20px rgba(0,0,0,0.08);
    }

    .navbar-inner { padding: 10px 0; }

    .logo-wrapper {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
    }

    .logo-img-container {
        position: relative;
        width: 58px;
        height: 58px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(201,168,76,0.2), transparent);
        border: 2px solid rgba(201,168,76,0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 18px rgba(201,168,76,0.3), 0 0 40px rgba(201,168,76,0.1);
        transition: all 0.3s;
    }

    .logo-img-container:hover {
        box-shadow: 0 0 30px rgba(201,168,76,0.6), 0 0 60px rgba(201,168,76,0.2);
        border-color: #C9A84C;
    }

    .logo-img-container img {
        width: 48px;
        height: 48px;
        object-fit: contain;
        border-radius: 50%;
    }

    .logo-texts {
        display: flex;
        flex-direction: column;
        line-height: 1.1;
    }

    .brand-name {
        font-size: 1.5rem;
        font-weight: 900;
        letter-spacing: 1px;
        background: linear-gradient(135deg, #8B6914, #C9A84C, #8B6914);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .brand-slogan {
        font-size: 0.65rem;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: #999;
    }

    .nav-link {
        color: #444 !important;
        font-weight: 600;
        font-size: 0.88rem;
        padding: 8px 14px !important;
        border-radius: 8px;
        transition: all 0.2s;
    }

    .nav-link:hover {
        color: #8B6914 !important;
        background: rgba(201,168,76,0.12);
    }

    .btn-carrito {
        background: #1a1a1a;
        border: 2px solid #1a1a1a;
        color: #C9A84C !important;
        border-radius: 10px;
        padding: 8px 18px !important;
        font-weight: 700;
        transition: all 0.3s;
    }

    .btn-carrito:hover {
        background: #333;
        border-color: #C9A84C;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }

    /* ── Main ── */
    main { min-height: calc(100vh - 140px); }

    /* ── Cards ── */
    .card {
        background: #fff;
        border: 1px solid #e5e0d5;
        border-radius: 14px;
        color: #1a1a1a;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }

    .card-header {
        background: #1a1a1a;
        border-bottom: 1px solid #333;
        border-radius: 14px 14px 0 0 !important;
        color: #C9A84C;
        font-weight: 700;
    }

    /* ── Tables ── */
    .table { color: #333; }
    .table-dark { background: #1a1a1a !important; color: #C9A84C !important; }
    .table-hover tbody tr:hover {
        background: rgba(201,168,76,0.08);
    }

    /* ── Buttons ── */
    .btn-primary {
        background: #1a1a1a;
        border: none;
        color: #C9A84C;
        font-weight: 700;
        border-radius: 8px;
        transition: all 0.3s;
        letter-spacing: 0.3px;
    }

    .btn-primary:hover {
        background: #333;
        color: #F0D080;
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.25);
    }

    .btn-outline-primary {
        border: 2px solid #1a1a1a;
        color: #1a1a1a;
        border-radius: 8px;
        font-weight: 600;
    }

    .btn-outline-primary:hover {
        background: #1a1a1a;
        color: #C9A84C;
    }

    .btn-success {
        background: linear-gradient(135deg, #166534, #16a34a);
        border: none;
        font-weight: 700;
        border-radius: 8px;
        color: #fff;
    }

    .btn-outline-secondary {
        border: 2px solid #555;
        color: #555;
        border-radius: 8px;
        font-weight: 600;
    }

    .btn-outline-secondary:hover {
        background: #555;
        color: #fff;
    }

    .btn-outline-warning {
        border: 2px solid #C9A84C;
        color: #8B6914;
        border-radius: 8px;
        font-weight: 600;
    }

    .btn-outline-warning:hover {
        background: #C9A84C;
        color: #000;
    }

    .btn-outline-danger {
        border: 2px solid #dc2626;
        color: #dc2626;
        border-radius: 8px;
        font-weight: 600;
    }

    .btn-outline-danger:hover {
        background: #dc2626;
        color: #fff;
    }

    .btn-outline-info {
        border: 2px solid #0891b2;
        color: #0891b2;
        border-radius: 8px;
        font-weight: 600;
    }

    .btn-outline-info:hover {
        background: #0891b2;
        color: #fff;
    }

    /* ── Forms ── */
    .form-control, .form-select {
        background: #fafafa;
        border: 2px solid #ddd;
        color: #1a1a1a;
        border-radius: 8px;
    }

    .form-control:focus, .form-select:focus {
        background: #fff;
        border-color: #C9A84C;
        box-shadow: 0 0 0 3px rgba(201,168,76,0.2);
        color: #1a1a1a;
    }

    .form-control::placeholder { color: #aaa; }
    .form-label { color: #555; font-size: 0.85rem; font-weight: 700; }

    .input-group-text {
        background: #1a1a1a;
        border-color: #1a1a1a;
        color: #C9A84C;
        font-weight: 700;
    }

    /* ── Badges ── */
    .badge { border-radius: 6px; font-weight: 700; }

    /* ── Alerts ── */
    .alert-success {
        background: rgba(22,163,74,0.1);
        border: 1px solid rgba(22,163,74,0.4);
        color: #166534;
        border-radius: 10px;
    }

    .alert-danger {
        background: rgba(220,38,38,0.1);
        border: 1px solid rgba(220,38,38,0.4);
        color: #991b1b;
        border-radius: 10px;
    }

    .alert-info {
        background: rgba(201,168,76,0.1);
        border: 1px solid rgba(201,168,76,0.4);
        color: #8B6914;
        border-radius: 10px;
    }

    /* ── Paginacion ── */
    .pagination .page-link {
        background: #fff;
        border: 2px solid #ddd;
        color: #555;
        border-radius: 8px !important;
        margin: 0 2px;
        font-weight: 600;
    }

    .pagination .page-link:hover {
        background: rgba(201,168,76,0.1);
        border-color: #C9A84C;
        color: #8B6914;
    }

    .pagination .page-item.active .page-link {
        background: #1a1a1a;
        border-color: #1a1a1a;
        color: #C9A84C;
        font-weight: 700;
    }

    .pagination .page-item.disabled .page-link {
        background: #f5f5f5;
        border-color: #eee;
        color: #ccc;
    }

    /* ── Footer ── */
    footer {
        background: white;
        border-top: 3px solid #C9A84C;
        color: gray;
        font-size: 0.8rem;
        padding: 24px 0;
        text-align: center;
        margin-top: 60px;
    }

    footer .footer-logo {
        width: 36px;
        height: 36px;
        object-fit: contain;
        border-radius: 50%;
        border: 1px solid rgba(201,168,76,0.4);
        margin-bottom: 8px;
    }

    footer span { color: #C9A84C; font-weight: 700; }

    /* ── Scrollbar ── */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #f5f0e8; }
    ::-webkit-scrollbar-thumb { background: #ccc; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #C9A84C; }
</style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-main">
        <div class="container navbar-inner">

            <!-- Logo destacado -->
            <a class="logo-wrapper" href="/">
                <div class="logo-img-container">
                    <img src="/images/MiTiendaVirtualLogo.png" alt="FullStep" />
                </div>
                <div class="logo-texts">
                    <span class="brand-name">FullStep</span>
                    <span class="brand-slogan">Zapatos para cada paso</span>
                </div>
            </a>

            <button class="navbar-toggler border-0" type="button"
                    data-bs-toggle="collapse" data-bs-target="#navMenu"
                    style="color:#C9A84C">
                <i class="bi bi-list" style="font-size:1.6rem"></i>
            </button>

            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav me-auto ms-4">
                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            <i class="bi bi-house"></i> Inicio
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Producto">
                            <i class="bi bi-shop"></i> Catálogo
                        </a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/admin">
                                <i class="bi bi-gear"></i> Admin
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Auth/Logout">
                                <i class="bi bi-box-arrow-right"></i> Salir
                            </a>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link btn-carrito position-relative" href="/Carrito">
                            <i class="bi bi-cart3"></i> Carrito
                            @{
                                var carritoJson = Context.Session.GetString("Carrito");
                                var carritoCount = 0;
                                if (!string.IsNullOrEmpty(carritoJson))
                                {
                                    var carritoItems = System.Text.Json.JsonSerializer
                                        .Deserialize<List<AppTiendaVirtual.Models.CarritoItem>>(carritoJson);
                                    carritoCount = carritoItems?.Sum(i => i.Cantidad) ?? 0;
                                }
                            }
                            @if (carritoCount > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill"
                                      style="background:#C9A84C;color:#000;font-size:0.65rem;font-weight:800">
                                    @carritoCount
                                </span>
                            }
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer>
        <img src="/images/MiTiendaVirtualLogo.png" alt="FullStep" class="footer-logo" />
        <div>© @DateTime.Now.Year <span>FullStep</span> — Zapatos para cada paso</div>
        <div style="margin-top:4px;font-size:0.7rem;color:#222"></div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Modal de advertencia global -->
    <div class="modal fade" id="modalAviso" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content"
                 style="background:#141414;border:1px solid rgba(201,168,76,0.3);border-radius:16px">
                <div class="modal-body text-center py-4 px-4">
                    <div id="modalIcono" style="font-size:3rem;margin-bottom:12px">⚠️</div>
                    <h5 id="modalTitulo" class="fw-bold mb-2" style="color:#C9A84C"></h5>
                    <p id="modalMensaje" style="color:#aaa;font-size:0.95rem;margin-bottom:24px"></p>
                    <button type="button" class="btn btn-primary px-5" data-bs-dismiss="modal">
                        Entendido
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        function mostrarAviso(titulo, mensaje, icono = '⚠️') {
            document.getElementById('modalTitulo').textContent = titulo;
            document.getElementById('modalMensaje').textContent = mensaje;
            document.getElementById('modalIcono').textContent = icono;
            new bootstrap.Modal(document.getElementById('modalAviso')).show();
        }
    </script>

</body>
</html>